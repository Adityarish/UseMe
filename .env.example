# Public URL and Supabase authentication
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# PostgreSQL
DATABASE_URL=postgresql://useme:useme@localhost:5432/useme

# Required for signing short-lived clip access cookies (at least 32 random bytes)
APP_SECRET=generate-a-random-value-with-python3-run.py

# Storage: use "local" only for development; production must use "google-drive"
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.local-storage
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Limits and retention
MAX_CLIP_BYTES=52428800
MAX_FILES_PER_CLIP=20
UPLOAD_SESSION_MINUTES=60
ONE_TIME_SESSION_MINUTES=10
ANONYMOUS_MAX_EXPIRY_DAYS=30

# Operations
CLEANUP_SECRET=generate-a-different-random-value-with-python3-run.py
TRUSTED_PROXY=false
MALWARE_SCAN_WEBHOOK_URL=
MALWARE_SCAN_WEBHOOK_SECRET=

