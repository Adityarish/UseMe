# Copy this file to .env.local. Never commit real passwords or secrets.

# -----------------------------------------------------------------------------
# Required application settings
# -----------------------------------------------------------------------------
APP_URL=http://localhost:3000

# Generate these independently with: openssl rand -base64 48
APP_SECRET=generate-a-random-value-with-python3-run.py
CLEANUP_SECRET=generate-a-different-random-value-with-python3-run.py

# -----------------------------------------------------------------------------
# Required Supabase project settings
# Supabase Dashboard -> Project Settings -> API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set the admin allowlist only in your untracked .env.local file.
# Leave empty to disable admin access.
ADMIN_EMAILS=

# Supabase Dashboard -> Connect
# Local development: use the Session pooler URL (port 5432).
# Vercel/serverless: use the Transaction pooler URL (port 6543).
# Keep SSL enabled. Percent-encode reserved characters in the database password.
DATABASE_URL=

# Optional for local development. Recommended for production migrations when
# DATABASE_URL uses the Transaction pooler. Use the Direct connection or
# Session pooler URL (port 5432). npm run db:migrate falls back to DATABASE_URL
# when this is blank.
MIGRATION_DATABASE_URL=

# -----------------------------------------------------------------------------
# Storage
# Use "local" only for development. Production requires "google-drive" and all
# four GOOGLE_* values below.
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.local-storage
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# -----------------------------------------------------------------------------
# Limits and retention (optional; defaults shown)
# -----------------------------------------------------------------------------
MAX_CLIP_BYTES=52428800
MAX_FILES_PER_CLIP=20
UPLOAD_SESSION_MINUTES=60
ONE_TIME_SESSION_MINUTES=10
ANONYMOUS_MAX_EXPIRY_DAYS=30

# -----------------------------------------------------------------------------
# Operations
# -----------------------------------------------------------------------------
TRUSTED_PROXY=false

# Reserved for a future malware-scanner integration. Leave blank for now.
MALWARE_SCAN_WEBHOOK_URL=
MALWARE_SCAN_WEBHOOK_SECRET=

